{
  "manifest_version": 3,
  "name": "Uncanny",
  "version": "0.3.0",
  "description": "Estimate whether Shorts, Reels, and TikToks contain AI-generated visual content.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze with Uncanny"
  }
}
